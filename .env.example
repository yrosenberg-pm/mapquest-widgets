# Copy to ".env.local" and fill in values. Do not commit .env.local.

# MapQuest server key (geocoding, /api/mapquest, and map tile proxy — never commit the real value)
MAPQUEST_API_KEY=

# Client key: only for customer embeds that pass ?apiKey=… (optional on hosted gallery)
NEXT_PUBLIC_MAPQUEST_API_KEY=

# Set to 1 on gallery/production so maps load via /api/mapquest/resource (hides key in Network)
NEXT_PUBLIC_MAPQUEST_PROXY_MAPS=1

# Road basemap: MapQuest vector styles (light/dark) when 1 or true; raster vivid/night when 0/false/unset
NEXT_PUBLIC_MAPQUEST_VECTOR_BASEMAP=1

# Mapillary — server routes (e.g. Neighborhood Score proxy) if used
MAPILLARY_ACCESS_TOKEN=

# Mapillary — browser-only (Mapillary Street View showcase widget + client Graph API)
# Get a client access token at https://www.mapillary.com/dashboard/developers
NEXT_PUBLIC_MAPILLARY_ACCESS_TOKEN=

# Legacy / OAuth (optional)
MAPILLARY_CLIENT_ID=
MAPILLARY_CLIENT_SECRET=
MAPILLARY_AUTH_URL=
